<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>Deployer · #(title)</title>
  <link rel="icon" type="image/png" href="#(deployer.panelRoute)/deployer.ico">
  <link rel="stylesheet" href="#(deployer.panelRoute)/deployer.css">
</head>
<body class="dp-logs-page">

  <div class="dp-shell">
    <div class="dp-page">
      <main class="dp-main">
        <section class="dp-target-section">

          <div class="dp-session-bar">
            <a class="dp-settings-back" href="#(deployer.panelRoute)" title="Back to panel">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="15 18 9 12 15 6"/>
              </svg>
              Back
            </a>
            <form class="dp-logout-form" method="POST" action="#(deployer.panelRoute)/logout">
              <button type="submit" class="dp-logout-btn" title="Sign out">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                  <polyline points="16 17 21 12 16 7"/>
                  <line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
                Sign out
              </button>
            </form>
          </div>

          <div class="dp-workspace">

            <div class="dp-target-panel">

              <div class="dp-runtime-bar">
                <div class="dp-runtime-brand">
                  <h2 class="dp-target-name">
                    #(title)
                  </h2>
                </div>

                <div class="dp-runtime-items">
                  <div class="dp-context-item">
                    <span class="dp-context-label">#(source.label)</span>
                    <span class="dp-context-value">#(source.name)</span>
                  </div>
                  <div class="dp-context-item">
                    <span class="dp-context-label">File</span>
                    <span class="dp-context-value">#(source.logFilePath)</span>
                  </div>
                  <div class="dp-context-item">
                    <span class="dp-context-label">Retained</span>
                    <span class="dp-context-value">#(retainedLineCount) lines</span>
                  </div>
                </div>

                <div class="dp-runtime-actions dp-runtime-actions--desktop">
                  <button type="button" class="dp-update-btn dp-log-clear-btn" id="dp-log-clear" title="Clear visible logs">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="3 6 5 6 21 6"/>
                      <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                      <path d="M10 11v6"/>
                      <path d="M14 11v6"/>
                      <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                    </svg>
                    Clear
                  </button>
                  <button type="button" class="dp-update-btn dp-log-copy-btn" id="dp-log-copy" title="Copy visible logs">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                    </svg>
                    Copy
                  </button>
                  <button type="button" class="dp-update-btn dp-log-wrap-btn dp-log-wrap-btn--active" mist-action="toggleWrap" mist-actions-for="#(componentName)" title="Toggle line wrapping">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="3 7 15 7 15 11 12 11"/>
                      <path d="M12 11l3 3 3-3"/>
                      <line x1="3" y1="17" x2="21" y2="17"/>
                    </svg>
                    Wrap
                  </button>
                </div>
              </div>

              <div class="dp-settings-body dp-app-log-body">
                #unsafeHTML(logsHTML)
              </div>

            </div>

          </div>

        </section>
      </main>
    </div>
  </div>

  <script src="#(deployer.panelRoute)/morphdom.js"></script>
  <script src="#(deployer.panelRoute)/mist.js" data-url="#(deployer.panelRoute)/ws"></script>
  <script>
    (function () {
      const logConsole = document.getElementById('#(consoleID)');
      const clearButton = document.getElementById('dp-log-clear');
      const copyButton = document.getElementById('dp-log-copy');

      clearButton.addEventListener('click', function () {
        if (window.ws && typeof window.ws.clearStreamTarget === 'function') {
          window.ws.clearStreamTarget(logConsole);
        } else {
          logConsole.textContent = '';
        }
      });

      copyButton.addEventListener('click', async function () {
        try {
          await navigator.clipboard.writeText(logConsole.textContent || '');
          copyButton.classList.add('dp-log-copy-btn--copied');
          setTimeout(function () {
            copyButton.classList.remove('dp-log-copy-btn--copied');
          }, 900);
        } catch (error) {
          console.error('Could not copy logs:', error);
        }
      });
    })();
  </script>

</body>
</html>
