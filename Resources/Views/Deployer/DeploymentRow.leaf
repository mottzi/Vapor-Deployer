<tbody
  mist-component="DeploymentRow-#(context.deployment.product)"
  mist-id="#(context.deployment.id)"
  data-mist-sort-value="#if(context.deployment.startedAtUnixMs):#(context.deployment.startedAtUnixMs)#endif"
  class="dp-tbody"
>

  <!-- ── Main row ──────────────────────────────────────────── -->
  <tr class="dp-tr
    #if(context.deployment.displayStatus == "pushed"):row-pushed
    #elseif(context.deployment.displayStatus == "testing"):row-testing
    #elseif(context.deployment.displayStatus == "building"):row-building
    #elseif(context.deployment.displayStatus == "restoring"):row-restoring
    #elseif(context.deployment.displayStatus == "built"):row-built
    #elseif(context.deployment.displayStatus == "running"):row-running
    #elseif(context.deployment.displayStatus == "failed"):row-failed
    #elseif(context.deployment.displayStatus == "canceled"):row-canceled
    #elseif(context.deployment.displayStatus == "stale"):row-stale
    #endif
    #if(context.deployment.hasDetails):dp-tr--interactive#endif
  "
  #if(context.deployment.hasDetails):
    mist-action="toggleDetails"
    role="button"
    aria-expanded="#if(state.detailsExpanded):true#else:false#endif"
    tabindex="0"
  #endif
  >

    <!-- Status -->
    <td class="dp-td dp-td-status">
      <span class="dp-status dp-status--#(context.deployment.displayStatus)">
        #(context.deployment.displayStatus)
        #if(context.deployment.hasDetails):
          <svg class="dp-status-chevron" xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-left: 2px;">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        #endif
      </span>
    </td>

    <!-- Tests (audit indicator — driven entirely by lastTestOutcome, independent of status) -->
    <td class="dp-td dp-td-tests dp-td-sm-hide dp-td-mobile-hide">
      #if(context.deployment.testsPassed):
        <span class="dp-test-glyph dp-test-glyph--pass" title="Tests passed" aria-label="Tests passed">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 640 640" fill="currentColor" aria-hidden="true"><path d="M480 96C515.3 96 544 124.7 544 160L544 480C544 515.3 515.3 544 480 544L160 544C124.7 544 96 515.3 96 480L96 160C96 124.7 124.7 96 160 96L480 96zM438 209.7C427.3 201.9 412.3 204.3 404.5 215L285.1 379.2L233 327.1C223.6 317.7 208.4 317.7 199.1 327.1C189.8 336.5 189.7 351.7 199.1 361L271.1 433C276.1 438 283 440.5 289.9 440C296.8 439.5 303.3 435.9 307.4 430.2L443.3 243.2C451.1 232.5 448.7 217.5 438 209.7z"/></svg>
        </span>
      #elseif(context.deployment.testsFailed):
        <span class="dp-test-glyph dp-test-glyph--fail" title="Tests failed" aria-label="Tests failed">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 640 640" fill="currentColor" aria-hidden="true"><path d="M160 96C124.7 96 96 124.7 96 160L96 480C96 515.3 124.7 544 160 544L480 544C515.3 544 544 515.3 544 480L544 160C544 124.7 515.3 96 480 96L160 96zM231 231C240.4 221.6 255.6 221.6 264.9 231L319.9 286L374.9 231C384.3 221.6 399.5 221.6 408.8 231C418.1 240.4 418.2 255.6 408.8 264.9L353.8 319.9L408.8 374.9C418.2 384.3 418.2 399.5 408.8 408.8C399.4 418.1 384.2 418.2 374.9 408.8L319.9 353.8L264.9 408.8C255.5 418.2 240.3 418.2 231 408.8C221.7 399.4 221.6 384.2 231 374.9L286 319.9L231 264.9C221.6 255.5 221.6 240.3 231 231z"/></svg>
        </span>
      #else:
        <span class="dp-test-glyph-dash">—</span>
      #endif
    </td>

    <!-- Commit message -->
    <td class="dp-td dp-td-commit">
      #if(context.deployment.displayStatus == "canceled"):
        <span class="dp-msg dp-msg--muted">#(context.deployment.commitMessage)</span>
      #else:
        <span class="dp-msg">#(context.deployment.commitMessage)</span>
      #endif
    </td>

    <!-- ID -->
    <td class="dp-td dp-td-sm-hide dp-td-mobile-hide" mist-action="">
      <a
        onclick="navigator.clipboard.writeText('#(context.deployment.id)'); return false;"
        href="##"
        class="dp-id"
        title="#(context.deployment.id)"
      >
        #(context.deployment.shortID)
        <svg class="dp-id-copy" xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
      </a>
    </td>

    <!-- Started -->
    <td class="dp-td dp-td-started">
      #if(context.deployment.startedAtUnixMs):
        <span
          class="dp-time"
          mist-behavior="local-datetime"
          data-started-at-unix-ms="#(context.deployment.startedAtUnixMs)"
        >
          <span class="dp-time-value">&nbsp;</span>
          <span class="dp-time-date">&nbsp;</span>
        </span>
      #else:
        <span class="dp-time">
          -
          <span class="dp-time-date">-</span>
        </span>
      #endif
    </td>

    <!-- Build -->
    <td class="dp-td dp-td-build">
      <div class="dp-build">
        #if(context.deployment.durationString):
          <span class="dp-duration">#(context.deployment.durationString)</span>
        #elseif(context.deployment.displayStatus == "pushed"):
          <span class="dp-duration-dash">—</span>
        #elseif(context.deployment.displayStatus == "stale"):
          <span class="dp-duration-dash">—</span>
        #elseif(context.deployment.displayStatus == "canceled"):
          <span class="dp-duration-dash">—</span>
        #else:
          <span class="dp-duration">
            <span class="dp-spinner"></span>
            <span
              class="dp-duration-live"
              mist-behavior="timer"
              data-started-at-unix-ms="#(context.deployment.startedAtUnixMs)"
            >0.0s</span>
          </span>
        #endif
        #if(context.deployment.hasSavedBinary):
          <span class="dp-binary-size">#(context.deployment.binarySizeMB) MB</span>
        #else:
          <span class="dp-binary-dash">—</span>
        #endif
      </div>
    </td>

    <!-- Actions -->
    <td class="dp-td dp-td-action" mist-action="">
      <div class="dp-row-actions">
        #if(context.deployment.canBuild || context.deployment.canRestoreBinary || context.deployment.canTest || !context.deployment.isLive):
        <button
          type="button"
          class="dp-dropdown-trigger"
          popovertarget="dp-menu-#(context.deployment.id)"
          title="Actions"
          aria-label="Actions"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 640 640" fill="currentColor"><!--!Font Awesome Free v7.2.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path d="M96 320C96 289.1 121.1 264 152 264C182.9 264 208 289.1 208 320C208 350.9 182.9 376 152 376C121.1 376 96 350.9 96 320zM264 320C264 289.1 289.1 264 320 264C350.9 264 376 289.1 376 320C376 350.9 350.9 376 320 376C289.1 376 264 350.9 264 320zM488 264C518.9 264 544 289.1 544 320C544 350.9 518.9 376 488 376C457.1 376 432 350.9 432 320C432 289.1 457.1 264 488 264z"/></svg>
        </button>
        <div
          id="dp-menu-#(context.deployment.id)"
          popover
          class="dp-dropdown-menu"
        >
            #if(context.deployment.canBuild):
              <button mist-action="deploy" popovertarget="dp-menu-#(context.deployment.id)" popovertargetaction="hide" class="dp-dropdown-item dp-deploy-item" type="button" aria-label="Build and run this commit">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 640 640" fill="currentColor" aria-hidden="true"><!--!Font Awesome Free v7.2.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path d="M187.2 100.9C174.8 94.1 159.8 94.4 147.6 101.6C135.4 108.8 128 121.9 128 136L128 504C128 518.1 135.5 531.2 147.6 538.4C159.7 545.6 174.8 545.9 187.2 539.1L523.2 355.1C536 348.1 544 334.6 544 320C544 305.4 536 291.9 523.2 284.9L187.2 100.9z"/></svg>
                Build &amp; Run
              </button>
              <button mist-action="saveBinary" popovertarget="dp-menu-#(context.deployment.id)" popovertargetaction="hide" class="dp-dropdown-item dp-save-binary-item" type="button" aria-label="Build and save binary">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 640 640" fill="currentColor" aria-hidden="true"><!--!Font Awesome Free v7.2.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path d="M246.9 82.3L271 67.8C292.6 54.8 317.3 48 342.5 48C379.3 48 414.7 62.6 440.7 88.7L504.6 152.6C519.6 167.6 528 188 528 209.2L528 240.1L547.7 259.8L547.7 259.8C563.3 244.2 588.6 244.2 604.3 259.8C620 275.4 619.9 300.7 604.3 316.4L540.3 380.4C524.7 396 499.4 396 483.7 380.4C468 364.8 468.1 339.5 483.7 323.8L464 304L433.1 304C411.9 304 391.5 295.6 376.5 280.6L327.4 231.5C312.4 216.5 304 196.1 304 174.9L304 162.2C304 151 298.1 140.5 288.5 134.8L246.9 109.8C236.5 103.6 236.5 88.6 246.9 82.4zM50.7 466.7L272.8 244.6L363.3 335.1L141.2 557.2C116.2 582.2 75.7 582.2 50.7 557.2C25.7 532.2 25.7 491.7 50.7 466.7z"/></svg>
                Build
              </button>
            #elseif(context.deployment.canRestoreBinary):
              <button mist-action="restoreBinary" popovertarget="dp-menu-#(context.deployment.id)" popovertargetaction="hide" class="dp-dropdown-item dp-restore-binary-item" type="button" aria-label="Run saved binary">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 640 640" fill="currentColor" aria-hidden="true"><!--!Font Awesome Free v7.2.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path d="M187.2 100.9C174.8 94.1 159.8 94.4 147.6 101.6C135.4 108.8 128 121.9 128 136L128 504C128 518.1 135.5 531.2 147.6 538.4C159.7 545.6 174.8 545.9 187.2 539.1L523.2 355.1C536 348.1 544 334.6 544 320C544 305.4 536 291.9 523.2 284.9L187.2 100.9z"/></svg>
                Run
              </button>
              <button mist-action="removeBinary" popovertarget="dp-menu-#(context.deployment.id)" popovertargetaction="hide" class="dp-dropdown-item dp-remove-binary-item" type="button" aria-label="Remove binary">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 640 640" fill="currentColor" aria-hidden="true"><!--!Font Awesome Free v7.2.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path d="M320 96C333.5 96 346.3 101.6 355.4 111.6L531.4 303.6C544.3 317.6 547.6 337.9 540 355.4C532.4 372.9 515 384 496 384L144 384C125 384 107.7 372.8 100.1 355.3C92.5 337.8 95.8 317.6 108.7 303.5L284.7 111.5C293.7 101.6 306.5 96 320 96zM96 496C96 469.5 117.5 448 144 448L496 448C522.5 448 544 469.5 544 496C544 522.5 522.5 544 496 544L144 544C117.5 544 96 522.5 96 496z"/></svg>
                Remove binary
              </button>
            #endif
            #if(context.deployment.canTest):
              #if(context.deployment.canBuild || context.deployment.canRestoreBinary):
                <div class="dp-dropdown-divider"></div>
              #endif
              <button mist-action="test" popovertarget="dp-menu-#(context.deployment.id)" popovertargetaction="hide" class="dp-dropdown-item dp-test-item" type="button" aria-label="Run swift test against this commit">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 640 640" fill="currentColor" aria-hidden="true"><!--!Font Awesome Free v7.2.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path d="M81 279L279 81C289.9 70.1 304.6 64 320 64C335.4 64 350.1 70.1 361 81L559 279C569.9 289.9 576 304.6 576 320C576 335.4 569.9 350.1 559 361L361 559C350.1 569.9 335.4 576 320 576C304.6 576 289.9 569.9 279 559L81 361C70.1 350.1 64 335.4 64 320C64 304.6 70.1 289.9 81 279z"/></svg>
                Test
              </button>
            #endif
            #if(!context.deployment.isLive):
              #if(context.deployment.canBuild || context.deployment.canRestoreBinary || context.deployment.canTest):
                <div class="dp-dropdown-divider"></div>
              #endif
              <button mist-action="delete" popovertarget="dp-menu-#(context.deployment.id)" popovertargetaction="hide" class="dp-dropdown-item dp-delete-item" type="button" aria-label="Delete deployment">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="3 6 5 6 21 6"></polyline>
                  <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
                  <path d="M10 11v6"></path>
                  <path d="M14 11v6"></path>
                  <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path>
                </svg>
                Delete
              </button>
            #endif
        </div>
        #endif
      </div>
    </td>

  </tr>

  <!-- ── Output detail row ──────────────────────────────────── -->
  #if(context.deployment.hasDetails):
  <tr
    class="dp-output-row dp-output-tr #if(context.deployment.hasLiveOutputStream):dp-output-tr--live#elseif(context.deployment.status == "failed"):dp-output-tr--failed#else:dp-output-tr--static#endif #if(state.detailsExpanded):dp-output-expanded#endif"
  >
    <td colspan="7" class="dp-output-cell">
      <div class="dp-output-wrapper">
        #if(context.deployment.hasLiveOutputStream):
          <pre class="dp-output-pre dp-output-pre--live" mist-stream="deployment-log"></pre>
        #elseif(context.deployment.outputHTML):
          <pre class="dp-output-pre #if(context.deployment.status == "failed"):dp-output-pre--failed#else:dp-output-pre--static#endif">#unsafeHTML(context.deployment.outputHTML)</pre>
        #endif
        <button
          class="dp-copy-log-btn"
          title="Copy log to clipboard"
          onclick="copyLogToClipboard(this)"
          type="button"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
        </button>
      </div>
    </td>
  </tr>
  #endif

</tbody>
